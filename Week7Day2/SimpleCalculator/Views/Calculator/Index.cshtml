@{
    ViewData["Title"] = "Simple Calculator";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow p-4" style="width: 100%; max-width: 400px;">
        
        <h3 class="text-center mb-4">Simple Calculator</h3>

        <form method="post" action="/calculator/add">
            
            <div class="mb-3">
                <label class="form-label">First Number</label>
                <input type="text" name="num1" class="form-control" placeholder="Enter first number" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Second Number</label>
                <input type="text" name="num2" class="form-control" placeholder="Enter second number" required />
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
        </form>

        @if (ViewData["Result"] != null)
        {
            <div class="alert alert-success mt-4 text-center">
                <strong>Result:</strong> @ViewData["Result"]
            </div>
        }
    </div>
</div>