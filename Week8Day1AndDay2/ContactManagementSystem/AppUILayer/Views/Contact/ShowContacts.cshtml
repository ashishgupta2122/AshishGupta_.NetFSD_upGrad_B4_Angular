@model IEnumerable<DataAccessLayer.Models.ContactInfo>

<div class="container mt-4">
    <h2 class="text-center mb-4">Contact List</h2>

    <div class="d-flex justify-content-end mb-3">
        <a href="/contact/add" class="btn btn-primary">+ Add Contact</a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover text-center">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Company</th>
                    <th>Department</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FirstName @item.LastName</td>
                        <td>@item.EmailId</td>
                        <td>@item.MobileNo</td>
                        <td>@item.CompanyName</td>
                        <td>@item.DepartmentName</td>
                        <td>
                            <a href="/contact/details/@item.ContactId" class="btn btn-info btn-sm">View</a>
                            <a href="/contact/edit/@item.ContactId" class="btn btn-warning btn-sm">Edit</a>
                            <a href="/contact/delete/@item.ContactId" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>