@model ContactManagementApp.Models.ContactInfo

<h2 class="text-center">Add Contact</h2>

<form method="post" class="container">
    <div class="row">
        <div class="col-md-6">
            <label>First Name</label>
            <input asp-for="FirstName" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label>Last Name</label>
            <input asp-for="LastName" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label>Company</label>
            <input asp-for="CompanyName" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label>Email</label>
            <input asp-for="EmailId" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label>Mobile</label>
            <input asp-for="MobileNo" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label>Designation</label>
            <input asp-for="Designation" class="form-control" />
        </div>
    </div>

    <br />

    <button type="submit" class="btn btn-success">Save</button>
    <a href="/Contact/ShowContacts" class="btn btn-secondary">Back</a>
</form>