<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EMS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                margin: 0;
                font-family: 'Segoe UI', sans-serif;
                background: linear-gradient(135deg, #1e3c72, #2a5298);
                color: white;
            }

            /* NAVBAR */
            .custom-navbar {
                background: rgba(0, 0, 0, 0.4);
                backdrop-filter: blur(10px);
            }

            .navbar-brand {
                font-weight: bold;
                font-size: 22px;
                letter-spacing: 1px;
            }

            .nav-link {
                transition: 0.3s;
                border-radius: 8px;
                padding: 6px 12px;
            }

            .nav-link:hover {
                background: rgba(255, 255, 255, 0.2);
            }

            .nav-user {
                background: rgba(255, 255, 255, 0.2);
                border-radius: 20px;
                padding: 5px 12px;
            }

            .logout-btn {
                color: #ff4b2b !important;
                font-weight: bold;
            }

            .logout-btn:hover {
                background: rgba(255, 75, 43, 0.2);
            }

            /* MAIN BODY */
            .main-container {
                padding: 20px;
            }

            @@media (max-width: 768px) {
                .navbar-brand {
                    font-size: 18px;
                }
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar shadow-sm">
        <div class="container-fluid">

            <!-- LOGO -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                EMS
            </a>

            <!-- TOGGLER -->
            <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- MENU -->
            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav ms-auto align-items-center gap-2">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Event" asp-action="Index">📅 Events</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Session" asp-action="Index">🎤 Sessions</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Speaker" asp-action="Index">🧑‍🏫 Speakers</a>
                    </li>

                    @if (Context.Session.GetString("UserEmail") != null)
                    {
                        <!-- USER -->
                        <li class="nav-item">
                            <span class="nav-link nav-user">
                                👤 @Context.Session.GetString("UserEmail")
                            </span>
                        </li>

                        <!-- LOGOUT -->
                        <li class="nav-item">
                            <a class="nav-link logout-btn" asp-controller="Account" asp-action="Logout">
                                Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <!-- LOGIN -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                Login
                            </a>
                        </li>
                    }

                </ul>

            </div>

        </div>
    </nav>

    <!-- BODY -->
    <div class="container main-container">
        @RenderBody()
    </div>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>