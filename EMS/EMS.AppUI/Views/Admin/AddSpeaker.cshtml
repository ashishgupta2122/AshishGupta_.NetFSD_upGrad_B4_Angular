@model EMS.DAL.Models.SpeakersDetails

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow-lg p-4" style="border-radius:20px;">
                <h3 class="text-center mb-4">🎤 Add Speaker</h3>

                <form method="post">

                    <div class="mb-3">
                        <input asp-for="SpeakerName" class="form-control" placeholder="Speaker Name" />
                    </div>

                    <div class="mb-3">
                        <input asp-for="Topic" class="form-control" placeholder="Topic" />
                    </div>

                    <button class="btn btn-success w-100">Add Speaker</button>

                </form>
            </div>

        </div>
    </div>
</div>