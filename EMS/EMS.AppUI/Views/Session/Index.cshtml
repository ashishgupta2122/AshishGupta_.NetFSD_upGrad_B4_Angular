@model IEnumerable<EMS.DAL.Models.SessionInfo>

@{
    ViewData["Title"] = "Sessions";
}

<style>
    body {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        font-family: 'Segoe UI', sans-serif;
        color: white;
    }

    .session-card {
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        transition: 0.3s;
        color: white;
    }

    .session-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }

    .btn-add {
        background: linear-gradient(to right, #00c6ff, #0072ff);
        border: none;
        border-radius: 10px;
    }

    .btn-join {
        background: linear-gradient(to right, #11998e, #38ef7d);
        border: none;
    }

    .btn-delete {
        background: linear-gradient(to right, #ff416c, #ff4b2b);
        border: none;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }
</style>

<div class="container py-5">

    <!-- HEADER -->
    <div class="top-bar mb-4">
        <h2 class="fw-bold">🎯 Sessions</h2>

        <!-- ADMIN ONLY -->
        @if (Context.Session.GetString("Role") == "Admin")
        {
            <a href="/Admin/AddSession" class="btn btn-add px-4 py-2">
                + Add Session
            </a>
        }
    </div>

    <!-- CARDS -->
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card session-card p-4 shadow-lg h-100">

                    <h5 class="fw-bold mb-2">
                        @(string.IsNullOrEmpty(item.SessionTitle) ? "No Title" : item.SessionTitle)
                    </h5>

                    <p class="text-light small">
                        @(string.IsNullOrEmpty(item.Description) ? "No Description" : item.Description)
                    </p>

                    <div class="mb-2">
                        📌 @(item.Event?.EventName ?? "No Event")
                    </div>

                    <div class="mb-2">
                        🎤 @(item.Speaker?.SpeakerName ?? "No Speaker")
                    </div>

                    <div class="mb-2">
                        ⏱ @item.SessionStart.ToString("dd MMM hh:mm tt")
                    </div>

                    <div class="mb-3">
                        ⏳ @item.SessionEnd.ToString("dd MMM hh:mm tt")
                    </div>

                    <!-- ACTIONS -->
                    <div class="mt-auto d-grid gap-2">

                        <!--  PARTICIPANT -->
                        @if (Context.Session.GetString("Role") == "Participant")
                        {
                            @if (!string.IsNullOrEmpty(item.SessionUrl))
                            {
                                <a href="@item.SessionUrl" target="_blank" class="btn btn-join btn-sm">
                                    🔗 Join Session
                                </a>
                            }
                        }

                        <!--  ADMIN -->
                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <a href="/Admin/DeleteSession/@item.SessionId" class="btn btn-delete btn-sm">
                                🗑 Delete
                            </a>
                        }

                    </div>

                </div>
            </div>
        }
    </div>

</div>