@model EMS.DAL.Models.EventDetails

<div class="container py-5 text-white">

    <!-- BACK BUTTON -->
    <div class="mb-3">
        <button onclick="history.back()" class="btn btn-light btn-sm">
            ⬅ Back
        </button>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card p-4 shadow-lg"
                 style="border-radius:20px; background:rgba(255,255,255,0.1); backdrop-filter:blur(10px);">

                <h2 class="fw-bold text-center mb-3">
                    📅 @Model.EventName
                </h2>

                <hr />

                <p><strong>Category:</strong> @Model.EventCategory</p>

                <p><strong>Date:</strong> @Model.EventDate.ToShortDateString()</p>

                <p class="mt-3"><strong>Description:</strong></p>
                <p>@Model.Description</p>

                @if (Context.Session.GetString("Role") == "Participant")
                {
                    <a href="/Home/RegisterEvent/@Model.EventId" class="btn btn-success w-100 mt-4">
                        ✅ Register for Event
                    </a>
                }

            </div>

        </div>
    </div>

</div>

<style>
    body {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
    }
</style>