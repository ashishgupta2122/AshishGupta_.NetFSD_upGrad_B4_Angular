@model EMS.DAL.Models.SpeakersDetails

@{
    ViewData["Title"] = "Add Speaker";
}

<style>
    body {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        font-family: 'Segoe UI', sans-serif;
        color: white;
    }

    .speaker-container {
        min-height: 100vh;
    }

    .speaker-card {
        border-radius: 20px;
        backdrop-filter: blur(12px);
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px;
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
    }

    .form-control::placeholder {
        color: #ddd;
    }

    .form-control:focus {
        box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
        background: rgba(255, 255, 255, 0.3);
        color: white;
    }

    .btn-save {
        border-radius: 10px;
        background: linear-gradient(to right, #11998e, #38ef7d);
        border: none;
        font-weight: bold;
        transition: 0.3s;
    }

    .btn-save:hover {
        transform: scale(1.03);
        opacity: 0.9;
    }

    label {
        font-weight: 500;
    }

    @@media (max-width: 768px) {
        .speaker-card {
            padding: 20px !important;
        }
    }
</style>

<div class="container d-flex justify-content-center align-items-center speaker-container">

    <div class="col-12 col-sm-10 col-md-6 col-lg-5">

        <div class="card speaker-card shadow-lg p-4">

            <h3 class="text-center mb-4 fw-bold">🧑‍🏫 Add Speaker</h3>

            <form method="post">

                <div class="mb-3">
                    <label>Speaker Name</label>
                    <input asp-for="SpeakerName" class="form-control" placeholder="Enter speaker name" required />
                    <span asp-validation-for="SpeakerName" class="text-danger small"></span>
                </div>

                <button class="btn btn-save w-100 py-2">
                    🚀 Save Speaker
                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}