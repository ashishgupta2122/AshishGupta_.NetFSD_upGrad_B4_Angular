@model List<EMS.DAL.Models.SpeakersDetails>

<div class="container-fluid py-5 speaker-container">

    <!--  TOP BAR -->
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap">
        <h2 class="fw-bold text-white">🎤 Speakers</h2>

        @if (Context.Session.GetString("Role") == "Admin")
        {
            <a href="/Admin/AddSpeaker" class="btn btn-add px-4 py-2">
                + Add Speaker
            </a>
        }
    </div>

    <div class="row g-4 justify-content-center">

        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-10 col-md-6 col-lg-4">

                <div class="card speaker-card text-center p-4">

                    <div class="speaker-icon mb-3">🧑‍🏫</div>

                    <h5 class="fw-bold">@item.SpeakerName</h5>

                    <p class="small text-light mb-3">
                        @(string.IsNullOrEmpty(item.Topic) ? "No topic assigned" : item.Topic)
                    </p>

                    <!--  ADMIN ONLY DELETE -->
                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <a href="/Admin/DeleteSpeaker/@item.SpeakerId" class="btn btn-danger w-100 mt-2">
                            🗑 Delete
                        </a>
                    }

                </div>

            </div>
        }

    </div>

</div>

<style>
    body {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        font-family: 'Segoe UI', sans-serif;
    }

    .speaker-container {
        min-height: 100vh;
    }

    .speaker-card {
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        color: white;
        transition: 0.3s;
    }

    .speaker-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
    }

    .speaker-icon {
        font-size: 50px;
    }

    .btn-add {
        border-radius: 10px;
        font-weight: 600;
        background: linear-gradient(to right, #00c6ff, #0072ff);
        border: none;
        transition: 0.3s;
    }

    .btn-add:hover {
        transform: scale(1.05);
    }

    .btn-danger {
        border-radius: 10px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-danger:hover {
        transform: scale(1.05);
        opacity: 0.9;
    }

    @@media (max-width: 768px) {
        .speaker-card {
            padding: 20px !important;
        }
    }
</style>