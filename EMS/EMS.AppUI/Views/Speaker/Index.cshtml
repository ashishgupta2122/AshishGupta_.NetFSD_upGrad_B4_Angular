@model IEnumerable<EMS.DAL.Models.SpeakersDetails>

@{
    ViewData["Title"] = "Speakers";
}

<style>
    body {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        font-family: 'Segoe UI', sans-serif;
        color: white;
    }

    .speaker-card {
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        transition: 0.3s;
        color: white;
    }

    .speaker-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }

    .avatar {
        width: 70px;
        height: 70px;
        font-size: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        background: linear-gradient(to right, #00c6ff, #0072ff);
        color: white;
        font-weight: bold;
    }

    .btn-custom {
        border-radius: 10px;
        font-size: 14px;
        transition: 0.3s;
    }

    .btn-custom:hover {
        transform: scale(1.05);
        opacity: 0.9;
    }

    .btn-add {
        background: linear-gradient(to right, #00c6ff, #0072ff);
        border: none;
    }

    .btn-delete {
        background: linear-gradient(to right, #ff416c, #ff4b2b);
        border: none;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .speaker-role {
        font-size: 13px;
        color: #ddd;
    }

    @@media (max-width: 768px) {
        .top-bar {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="container py-5">

    <!-- HEADER -->
    <div class="top-bar mb-4">
        <h2 class="fw-bold">🎤 Speakers</h2>
        <a href="/Speaker/Create" class="btn btn-custom btn-add px-4 py-2">
            + Add Speaker
        </a>
    </div>

    <!-- CARDS -->
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-3">

                <div class="card speaker-card p-4 text-center shadow-lg h-100">

                    <!-- AVATAR -->
                    <div class="mb-3">
                        <div class="avatar">
                            @(string.IsNullOrEmpty(item.SpeakerName) ? "?" : item.SpeakerName.Substring(0, 1))
                        </div>
                    </div>

                    <!-- NAME -->
                    <h5 class="fw-bold">
                        @(string.IsNullOrEmpty(item.SpeakerName) ? "No Name" : item.SpeakerName)
                    </h5>

                    <!-- ROLE -->
                    <p class="speaker-role flex-grow-1">Expert Speaker</p>

                    <!-- ACTIONS -->
                    <div class="mt-auto d-grid gap-2">

                        <a href="/Speaker/Edit/@item.SpeakerId" class="btn btn-warning btn-sm">
                            ✏ Edit
                        </a>

                        <form method="post" action="/Speaker/Delete/@item.SpeakerId">
                            <button class="btn btn-custom btn-delete btn-sm w-100">
                                🗑 Delete
                            </button>
                        </form>

                    </div>

                </div>

            </div>
        }
    </div>

</div>