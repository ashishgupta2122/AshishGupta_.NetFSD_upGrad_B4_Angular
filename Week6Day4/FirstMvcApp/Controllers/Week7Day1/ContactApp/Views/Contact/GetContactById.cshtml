@model ContactApp.Models.ContactInfo

<div class="container mt-5">

    <div class="card shadow p-4">

        <h3 class="text-center mb-4">Contact Details</h3>

        @if (Model != null)
        {
            <ul class="list-group">
                <li class="list-group-item"><b>ID:</b> @Model.ContactId</li>
                <li class="list-group-item"><b>Name:</b> @Model.FirstName @Model.LastName</li>
                <li class="list-group-item"><b>Company:</b> @Model.CompanyName</li>
                <li class="list-group-item"><b>Email:</b> @Model.EmailId</li>
                <li class="list-group-item"><b>Mobile:</b> @Model.MobileNo</li>
                <li class="list-group-item"><b>Designation:</b> @Model.Designation</li>
            </ul>
        }
        else
        {
            <p class="text-danger text-center">Contact Not Found</p>
        }

    </div>

</div>