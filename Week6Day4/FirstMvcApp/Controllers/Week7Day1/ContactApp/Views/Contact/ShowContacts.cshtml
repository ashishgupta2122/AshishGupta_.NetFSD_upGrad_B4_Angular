@model List<ContactApp.Models.ContactInfo>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Contact List</h2>
        <a href="/Contact/AddContact" class="btn btn-success">+ Add Contact</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Designation</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.ContactId</td>
                        <td>@c.FirstName @c.LastName</td>
                        <td>@c.CompanyName</td>
                        <td>@c.EmailId</td>
                        <td>@c.MobileNo</td>
                        <td>@c.Designation</td>
                        <td>
                            <a href="/Contact/GetContactById?id=@c.ContactId" class="btn btn-info btn-sm">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>