@model AppUILayer.Models.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="card shadow p-4">
        
        <h1 class="text-danger">Error</h1>
        <h4 class="text-danger mb-3">
            An error occurred while processing your request.
        </h4>

        @if (Model != null && Model.ShowRequestId)
        {
            <p>
                <strong>Request ID:</strong>
                <code>@Model.RequestId</code>
            </p>
        }

        <hr />

        <h5>Development Mode</h5>
        <p>
            Switching to <strong>Development</strong> environment will display more detailed information about the
            error.
        </p>

        <p class="text-warning">
            <strong>Note:</strong> Do not enable Development mode in production.
        </p>

        <div class="mt-3">
            <a asp-controller="Contact" asp-action="ShowContacts" class="btn btn-primary">
                Go to Home
            </a>
        </div>

    </div>
</div>