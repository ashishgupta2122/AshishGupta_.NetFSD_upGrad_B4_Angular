@model DataAccessLayer.Models.ContactInfo

@{
    ViewData["Title"] = "Contact Details";
}

@if (Model == null)
{
    <div class="alert alert-danger">
        No contact found.
    </div>

    <a asp-action="ShowContacts" class="btn btn-secondary">Back</a>
}
else
{
    <div class="container mt-4">
        <div class="card shadow p-4">
            <h3 class="mb-4 text-primary">Contact Details</h3>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>First Name:</strong>
                    <p>@Model.FirstName</p>
                </div>
                <div class="col-md-6">
                    <strong>Last Name:</strong>
                    <p>@Model.LastName</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Email:</strong>
                    <p>@Model.EmailId</p>
                </div>
                <div class="col-md-6">
                    <strong>Mobile:</strong>
                    <p>@Model.MobileNo</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Designation:</strong>
                    <p>@Model.Designation</p>
                </div>
                <div class="col-md-6">
                    <strong>Company:</strong>
                    <p>@Model.Company?.CompanyName</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Department:</strong>
                    <p>@Model.Department?.DepartmentName</p>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="EditContact" asp-route-id="@Model.ContactId" class="btn btn-warning">Edit</a>
                <a asp-action="ShowContacts" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
}