@model DataAccessLayer.Models.ContactInfo

@{
    ViewData["Title"] = "Add Contact";
}

<h2 class="mb-4">Add Contact</h2>

<form asp-action="AddContact" method="post" class="container">
    <div class="form-group mb-3">
        <label>First Name</label>
        <input asp-for="FirstName" class="form-control" placeholder="Enter First Name" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Last Name</label>
        <input asp-for="LastName" class="form-control" placeholder="Enter Last Name" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Email</label>
        <input asp-for="EmailId" class="form-control" placeholder="Enter Email" />
        <span asp-validation-for="EmailId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Mobile No</label>
        <input asp-for="MobileNo" class="form-control" placeholder="Enter Mobile Number" />
        <span asp-validation-for="MobileNo" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Designation</label>
        <input asp-for="Designation" class="form-control" placeholder="Enter Designation" />
        <span asp-validation-for="Designation" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Company</label>
        <select asp-for="CompanyId" class="form-control" asp-items="ViewBag.Companies">
            <option value="">-- Select Company --</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label>Department</label>
        <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments">
            <option value="">-- Select Department --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="ShowContacts" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}