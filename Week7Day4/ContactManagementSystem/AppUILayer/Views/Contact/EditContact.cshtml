@model DataAccessLayer.Models.ContactInfo

@{
    ViewData["Title"] = "Edit Contact";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h3 class="mb-4 text-success">Edit Contact</h3>

        <form asp-action="EditContact" method="post">

            <input type="hidden" asp-for="ContactId" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label>Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Email</label>
                    <input asp-for="EmailId" class="form-control" />
                    <span asp-validation-for="EmailId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label>Mobile</label>
                    <input asp-for="MobileNo" class="form-control" />
                    <span asp-validation-for="MobileNo" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Designation</label>
                    <input asp-for="Designation" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Company</label>
                    <select asp-for="CompanyId" class="form-control" asp-items="ViewBag.Companies">
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Department</label>
                    <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments">
                    </select>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-success">Update</button>
                <a asp-action="ShowContacts" class="btn btn-secondary">Cancel</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}